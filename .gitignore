# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/
/output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA commitar segredos
.env
.env.local
.env.production
.env.development
.env.e2e
# .env.example é seguro commitar (sem valores reais)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Sentry Config File
.env.sentry-build-plugin

# Playwright E2E
/e2e/.auth/
/e2e/report/
/e2e/results/
/playwright-report/
/test-results/

# Fichas técnicas e imports locais — não versionar binários grandes
data/imports/

# Backups do banco — NUNCA commitar dumps (contêm PII de clientes)
*.sql
*.sql.gz
*.sql.gz.gpg
*.dump
/backups/
metalab-backup-*
# ...mas migrations do Prisma SÃO .sql legítimos e precisam ser versionados
!prisma/migrations/**/*.sql
.env*
!.env.example
.design-preview/
MetaLab Design System.zip
MetaLab Design System (1).zip
*.zip

# Configuração local do Claude Code e pastas de trabalho de assets (não versionar)
.claude/
Vetorização de imagens e páginas de produtos/
