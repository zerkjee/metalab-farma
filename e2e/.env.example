# URL base da aplicação (padrão: http://localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Credenciais de usuário comum (necessário para testes de VIP, pedidos)
E2E_USER_EMAIL=testuser@example.com
E2E_USER_PASSWORD=SenhaTest@123

# Credenciais de admin (necessário para testes de admin)
E2E_ADMIN_EMAIL=admin@metalab.com
E2E_ADMIN_PASSWORD=AdminTest@123

# Slug de um produto ativo no banco para testes de PDP/carrinho
# Se vazio, o setup descobre automaticamente via homepage
E2E_PRODUCT_SLUG=

# Código de cupom válido para teste de desconto (opcional)
# Se vazio, o teste de cupom será pulado
E2E_COUPON_CODE=

# CEP válido para teste de frete no checkout
E2E_TEST_CEP=01310-100

# Se "1", testes de checkout mockam as APIs externas (recomendado em CI)
E2E_MOCK_APIS=1
