generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTENTICAÇÃO (NextAuth) ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── USUÁRIOS ────────────────────────────────────────────────────────────────

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  senha     String?
  papel     Papel    @default(CLIENTE)
  ativo     Boolean  @default(true)
  telefone  String?
  cpf       String?  @unique
  pontosResgatados Int @default(0)
  criadoEm DateTime @default(now())

  accounts   Account[]
  sessions   Session[]
  enderecos  Endereco[]
  pedidos    Pedido[]
  avaliacoes Avaliacao[]

  @@map("usuarios")
}

enum Papel {
  CLIENTE
  ADMIN
  SUPER_ADMIN
}

// ─── PRODUTOS ────────────────────────────────────────────────────────────────

model Categoria {
  id       String    @id @default(cuid())
  nome     String
  slug     String    @unique
  ordem    Int       @default(0)
  produtos Produto[]

  @@map("categorias")
}

enum TipoProduto {
  SIMPLES
  KIT
}

model Produto {
  id            String  @id @default(cuid())
  nome          String
  slug          String  @unique
  sku           String  @unique
  ean           String?
  marca         String  @default("Metalab")
  subtitulo     String?
  descricaoHtml String  @db.Text
  descricaoCurta String?

  // ─── Conteúdo (suplementos) ────────────────────────────────────────────────
  composicao    String? @db.Text
  modoDeUso     String? @db.Text

  // ─── Preço ────────────────────────────────────────────────────────────────
  preco         Decimal  @db.Decimal(10, 2)
  precoOriginal Decimal? @db.Decimal(10, 2)

  // ─── Estoque ──────────────────────────────────────────────────────────────
  estoque    Int @default(0)
  estoqueMin Int @default(5)

  // ─── Dimensões e peso (Melhor Envio) ──────────────────────────────────────
  pesoGramas    Int?
  alturaCm      Int?
  larguraCm     Int?
  comprimentoCm Int?

  // ─── Classificação ────────────────────────────────────────────────────────
  tipo        TipoProduto @default(SIMPLES)
  tags        String[]
  categoriaId String?
  categoria   Categoria?  @relation(fields: [categoriaId], references: [id])

  // ─── Visual ───────────────────────────────────────────────────────────────
  corPrincipal  String?
  corSecundaria String?
  imagemUrl     String?

  // ─── SEO ──────────────────────────────────────────────────────────────────
  metaTitulo    String?
  metaDescricao String?
  palavrasChave String?

  // ─── Flags ────────────────────────────────────────────────────────────────
  ativo    Boolean @default(true)
  destaque Boolean @default(false)

  // ─── Relações ─────────────────────────────────────────────────────────────
  imagens        ImagemProduto[]
  atributos      AtributoProduto[]
  avaliacoes     Avaliacao[]
  itens          ItemPedido[]
  kitItens       KitItem[]  @relation("KitPai")
  componenteDe   KitItem[]  @relation("KitComponente")

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, destaque])
  @@index([ativo, categoriaId])
  @@index([tipo])
  @@map("produtos")
}

model ImagemProduto {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  ordem     Int     @default(0)
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("imagens_produto")
}

model AtributoProduto {
  id        String  @id @default(cuid())
  chave     String
  valor     String
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("atributos_produto")
}

model KitItem {
  id         String  @id @default(cuid())
  quantidade Int     @default(1)
  ordem      Int     @default(0)

  kitId      String
  kit        Produto @relation("KitPai",       fields: [kitId],      references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto @relation("KitComponente", fields: [produtoId],  references: [id])

  @@unique([kitId, produtoId])
  @@index([kitId])
  @@map("kit_itens")
}

// ─── ENDEREÇOS ────────────────────────────────────────────────────────────────

model Endereco {
  id          String  @id @default(cuid())
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String  @db.Char(2)
  principal   Boolean @default(false)

  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidos   Pedido[]

  @@map("enderecos")
}

// ─── PEDIDOS ─────────────────────────────────────────────────────────────────

model Pedido {
  id     String       @id @default(cuid())
  numero String       @unique
  status StatusPedido @default(AGUARDANDO_PAGAMENTO)

  // Chave de idempotência: cliente gera um UUID uma vez por tentativa de checkout.
  // Retry de rede / duplo-submit com a mesma chave devolve o pedido já criado em
  // vez de criar um segundo. Nullable pra não quebrar pedidos antigos; unique só
  // quando presente (Postgres permite múltiplos NULL num índice unique).
  idempotencyKey String? @unique

  subtotal Decimal @db.Decimal(10, 2)
  desconto Decimal @default(0) @db.Decimal(10, 2)
  frete    Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  metodoPagamento MetodoPagamento?
  pagamentoId     String?
  pixQrCode       String?          @db.Text
  pixQrCodeBase64 String?          @db.Text
  pago            Boolean          @default(false)
  pagoEm          DateTime?

  codigoRastreio String?
  enviadoEm      DateTime?

  usuarioId  String?
  usuario    Usuario?  @relation(fields: [usuarioId], references: [id])
  enderecoId String?
  endereco   Endereco? @relation(fields: [enderecoId], references: [id])
  cupomId    String?
  cupom      Cupom?    @relation(fields: [cupomId], references: [id])
  itens      ItemPedido[]

  compradorNome     String
  compradorEmail    String
  compradorCpf      String
  compradorTelefone String?
  enderecoSnap      String? @db.Text

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // ─── Integração ERP Tiny ──────────────────────────────────────────────────
  tinyPedidoId       String?          // ID gerado pelo Tiny ao criar o pedido
  tinyStatus         String?          // Situação mais recente retornada pelo Tiny
  tinySyncStatus     TinySyncStatus   @default(PENDENTE)
  tinySyncAt         DateTime?        // Última tentativa de sincronização
  tinyErro           String?          @db.Text  // Mensagem de erro para debug
  nfNumero           String?          // Número da NF-e emitida pelo Tiny
  nfChave            String?          // Chave de acesso NF-e (44 dígitos)
  nfUrl              String?          // URL do DANFE/PDF
  tinyPayload        String?          @db.Text  // Payload bruto da última resposta Tiny
  tinyLastWebhookAt  DateTime?        // Último webhook recebido do Tiny

  // ─── Reconciliação (Agente 2, docs/tiny-architecture.md §4) ───────────────
  tinyNumero         String?          // spec tinyOrderNumber — nº do pedido gerado pelo Tiny (≠ numero interno, ≠ tinyPedidoId)
  nfStatus           String?          // spec invoiceStatus — situação da NF-e (ex.: "emitida", "autorizada")
  nfXmlUrl           String?          // spec tinyInvoiceXmlUrl — URL do XML da NF-e
  nfEmitidaEm        DateTime?        // spec invoiceIssuedAt — data/hora de emissão da NF-e

  @@index([usuarioId, criadoEm])
  @@index([pagamentoId])
  @@index([compradorEmail])
  @@index([status])
  @@index([tinySyncStatus])
  @@index([tinyPedidoId])
  @@map("pedidos")
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_APROVADO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
  REEMBOLSADO
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
}

enum TinySyncStatus {
  PENDENTE     // Pedido aprovado, ainda não enviado ao Tiny
  PROCESSANDO  // Sync em andamento (lock atômico — uso na Wave 2/3)
  ENVIADO      // Criado no Tiny com sucesso
  ERRO         // Falhou após todas as tentativas
  IGNORADO     // Cancelado antes de ser enviado
}

model ItemPedido {
  id         String  @id @default(cuid())
  quantidade Int
  precoUnit  Decimal @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id])
  produtoNome   String
  produtoSku    String
  produtoImagem String?

  @@map("itens_pedido")
}

// ─── CUPONS ───────────────────────────────────────────────────────────────────

model Cupom {
  id        String    @id @default(cuid())
  codigo    String    @unique
  tipo      TipoCupom
  valor     Decimal   @db.Decimal(10, 2)
  usoMaximo Int?
  usoAtual  Int       @default(0)
  validade  DateTime?
  ativo     Boolean   @default(true)
  pedidos   Pedido[]

  @@map("cupons")
}

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
  FRETE_GRATIS
}

// ─── AVALIAÇÕES ───────────────────────────────────────────────────────────────

model Avaliacao {
  id       String  @id @default(cuid())
  nota     Int
  titulo   String?
  texto    String?
  aprovada Boolean @default(false)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@unique([usuarioId, produtoId])
  @@index([produtoId, aprovada])
  @@map("avaliacoes")
}

// ─── BANNERS ─────────────────────────────────────────────────────────────────

model Banner {
  id        String  @id @default(cuid())
  titulo    String?
  subtitulo String?
  imagemUrl String
  linkUrl   String?
  cta       String?
  bg        String?
  accent    String?
  campanha  String?
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  @@map("banners")
}

// ─── CARRINHO ABANDONADO ─────────────────────────────────────────────────────

model CartSession {
  id           String   @id @default(cuid())
  email        String
  nome         String?
  itens        Json
  total        Decimal  @db.Decimal(10, 2)
  cupomCodigo  String?
  convertido   Boolean  @default(false)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([email])
  @@index([convertido, atualizadoEm])
  @@map("cart_sessions")
}

// ─── AUDITORIA ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  criadoEm  DateTime @default(now())
  adminId    String
  adminEmail String
  acao       String
  recurso    String
  recursoId  String?
  detalhe    String?  @db.Text
  ip         String?

  @@index([adminId])
  @@index([criadoEm])
  @@index([acao])
  @@map("audit_logs")
}
